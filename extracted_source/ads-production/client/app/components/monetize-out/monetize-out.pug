.page-container
  .panel.panel-default
    .panel-body(style='text-align: center')
      .col-md-12
        .row(style='display: flex; justify-content: flex-end;')
          button.btn.btn-primary(type='button', style='margin: 10px 0', ng-click='vm.save()') Save
      //- .col-md-12
      //-   label.radio-inline
      //-     input(type='radio', name='optshare', ng-checked='vm.obj.sharing === "false"', ng-model='vm.obj.sharing', ng-change='vm.obj.sharing = "false"')
      //-     | None Sharing
      //-   label.radio-inline
      //-     input(type='radio', name='optshare', ng-checked='vm.obj.sharing === "true"', ng-model='vm.obj.sharing', ng-change='vm.obj.sharing = "true"')
      //-     | Share with DSP
      .col-md-12(style='margin-top: 20px', ng-if='vm.obj.sharing === "true"')
        .row
          .form-group
            span.span-sharing(ng-class='vm.obj.sharingType === "location" ? "active" : ""') Select Locations
            label.switch-cutom(style='margin: 0 10px')
              input(type='checkbox', ng-true-value="'all'" ng-false-value="'location'" ng-model="vm.obj.sharingType")
              span.slider-button-custom
            span.span-sharing(ng-class='vm.obj.sharingType === "all" ? "active" : ""') Select All
        .row(ng-if='vm.obj.sharingType === "all"')
          .form-group(style='margin: 10px 0')
            app-rz-slider(my-model='vm.obj.shareAll' my-option='vm.slider.options')
        .row(ng-if='vm.obj.sharingType === "location"')
          .form-inline(style='margin-top:15px; margin-bottom:15px; padding: 10px; border-color: #ddd; box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);')
            .form-group
              label City/Province
              select.form-control(name='city' select2='vm.selectCity' ng-model='vm.obj.cityId' placeholder='Pick a City' ng-change='vm.selectCityChange()')
            .form-group
              label District
              select.form-control(name='district' select2='vm.selectDistrict' ng-model='vm.obj.districtId' placeholder='Pick a District', ng-change='vm.selectDistrictChange()')
          .form-group(style='margin: 10px 0;', ng-repeat='l in vm.selectLocations track by $index')
            label(style='color: #6b7381; width: 69%; margin-left:31%; text-align: left') {{l.name}} ({{l.cityName}} - {{l.districtName}})
            div(style='width: 70%; margin-left:30%; text-align: left')
              //- span.span-sharing.active Share
              //- label.switch-cutom(style='margin: 0 10px')
              //-   input(type='checkbox', ng-true-value="true" ng-false-value="false" ng-model="l.enableShare")
              //-   span.slider-button-custom
              app-rz-slider(my-model='l.sharingValue' my-option='vm.sliderWithLocation.options')
