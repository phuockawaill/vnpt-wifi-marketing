form#fmPreview.modal.fade.in(name='fmPreview', aria-labelledby='fmPreviewLabel' novalidate data-backdrop="static" data-keyboard="false")
  .modal-dialog.modal-full(style="margin-top:10px;margin-bottom:10px;")
    .modal-content
      .modal-header.bg-primary.preview(style="padding: 10px 20px")
        button.close(type='button', aria-label='Close' ng-click='vm.closeFrame()') ×
        #preview-btn
          span.btnt.icon-laptop(ng-class='vm.previewMode==="Laptop" ? "active" : ""' ng-click='vm.changeViewMode("Laptop")')
          span.btnt.icon-mobile(ng-class='vm.previewMode==="Mobile" ? "active" : ""' ng-click='vm.changeViewMode("Mobile")')
        h4#fmPreviewLabel.modal-title {{app.isLang === "VN" ? "Xem trên" : "Preview"}} {{vm.previewMode}}
      .modal-body(style="padding: 0")
        div#previewLink(style="max-width: none; overflow: auto; margin: 0 auto;")
