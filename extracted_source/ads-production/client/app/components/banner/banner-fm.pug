form#fmEdit.modal.fade.in(style='overflow: scroll', name='fmEdit', aria-labelledby='fmEditLabel', novalidate='novalidate', ng-submit='vm.obj.templateType === "video" ? vm.createVideo() : vm.create()', data-backdrop="static" data-keyboard="false")
  .modal-dialog.modal-fullscreen
    .modal-content
      .modal-header.bg-primary
        button.close(type='button', data-dismiss='modal', aria-label='Close', ng-click='vm.closeModal()') ×
        h4#fmEditLabel.modal-title Creative Ads
      .modal-body
        .row
          .form-group.col-md-12(validator='validator')
            label(style='font-weight: bold') {{app.isLang === "VN" ? "Tên" : "Name"}}
            input.form-control(name='name', placeholder='{{app.isLang === "VN" ? "Nhập tên" : "Give a name"}}', ng-model='vm.obj.name', required='required')
          .form-group.col-md-12
            label(style='font-weight: bold') {{app.isLang === "VN" ? "Chọn loại Creative Ads" : "Select Creative Ads Type"}}
            .row(style='display: flex; justify-content: center')
              .parent-btn-template
                button.btn-template(type='button', ng-click='vm.onChooseTemplate("passCode");', ng-class='vm.obj.templateType === "passCode" ? "active" : ""')
                  span.span-icon
                    i.fa.fa-html5
                  br
                  span.span-text Paste Code
                i
              .parent-btn-template
                button.btn-template(type='button', ng-click='vm.onChooseTemplate("static");', ng-class='vm.obj.templateType === "static" ? "active" : ""')
                  span.span-icon
                    i.fa.fa-picture-o
                  br
                  span.span-text Static Banner
                i
              .parent-btn-template(ng-if='!vm.quickSetup')
                button.btn-template(type='button', ng-click='vm.onChooseTemplate("video");', ng-class='vm.obj.templateType === "video" ? "active" : ""')
                  span.span-icon
                    i.fa.fa-file-video-o
                  br
                  span.span-text Video
                i
          .form-group.col-md-12(validator='validator', ng-show='vm.obj.templateType === "passCode"')
            label(style='font-weight: bold') HTML Code
            .row
              .col-md-4
                .form-group.div-call-warning
                  h5(style='margin-bottom: 20px') * NOTE:
                  ol.ol-custom-style
                    li
                      span {{app.isLang === "VN" ? "Nút" : "Your"}}
                        b
                          i  {{app.isLang === "VN" ? "Kết nối Internet " : "Connect Internet "}}
                        | {{app.isLang === "VN" ? "phải có " : "button must be have "}}
                        b
                          i id="submitLoginButton"
                    li
                      span {{app.isLang === "VN" ? "Copy đoạn " : "Copy our "}}
                        b
                          i &lt;script type="text/javascript"&gt; 
                        | {{app.isLang === "VN" ? "dưới đây và dán vào vùng HTML của bạn trước thẻ đóng  " : "here and pass to your HTML code before "}}
                        b
                          i &lt;/body&gt; 
                      .input-group(style='margin-top: 10px')
                        input#bodyScript.form-control(ng-model='vm.bodyScript')
                        .input-group-btn
                          button.btn.btn-primary(style='' type='button' ng-click='vm.onAction("copyCode", "bodyScript")') Copy script
                  div(style='margin: 10px 0')
                    a(data-target='#collapseExample' data-toggle="collapse") {{app.isLang === "VN" ? "Ví dụ" : "Example"}}
                      i.fa.fa-angle-down(style='margin-left: 5px')
                    #collapseExample.collapse(style='border: 1px dashed;border-radius: 4px;margin: 10px 0;padding: 5px; position: relative; width: 100%')
                      div.hovereffect
                        img#imgHtmlCodeExample(src="{{vm.imgHtmlCodeExample}}")
                        div.overlayeffect(ng-click='vm.modalImageFull(vm.imgHtmlCodeExample)')
                          h2 {{app.isLang === "VN" ? "Xem toàn màn hình" : "View Full screen"}}
                          p
                            a
                              i.fa.fa-eye(style='font-size:16px')
              .col-md-8
                textarea.code.form-control(name='passCode', placeholder='{{app.isLang === "VN" ? "Nhập HTML Code" : "Input your HTML code"}}', rows='20', ng-model='vm.obj.passCode', ng-required='vm.obj.templateType === "passCode"')
      .modal-footer
        button.btn.btn-link(type='button', data-dismiss='modal', ng-click='vm.closeModal()') {{app.isLang === "VN" ? "Hủy bỏ" : "Cancel"}}
        button.btn.btn-success(type='button', ng-click='vm.onAction("viewInForm", vm.obj)') {{app.isLang === "VN" ? "Xem trước" : "View"}}
        input.btn(type='submit', ng-disabled='fmEdit.$invalid', ng-class="vm.obj.id ? 'btn-info' : 'btn-primary'", ng-value="vm.obj.id ? (app.isLang === 'VN' ? 'Sửa' : 'Edit') : (app.isLang === 'VN' ? 'Tạo' : 'Create')", ng-show="vm.obj.templateType !== 'video'")
        input.btn(type='submit', ng-disabled="fmEdit.$invalid", ng-class="vm.objVideo.id ? 'btn-info' : 'btn-primary'", ng-value="vm.objVideo.id ? (app.isLang === 'VN' ? 'Sửa' : 'Edit') : (app.isLang === 'VN' ? 'Tạo' : 'Create')", ng-show="vm.obj.templateType === 'video'")


