.btn-group.btn-group-xs
  a.btn.btn-info(data-toggle='modal', data-target='#fmEdit' ng-click='vm.onAction("edit", data)')
    |  {{app.isLang === "VN" ? "Sửa" : "Edit"}}
  .btn-group.btn-group-xs
    a.btn.btn-danger(ng-click='vm.onAction("delete", data)')
          |  {{app.isLang === "VN" ? "Xóa" : "Delete"}}
