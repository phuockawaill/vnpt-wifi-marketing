form#fmPass.modal.fade(modal='app.modalPassOptions' tabindex='-1' role='dialog' name='fmPass'
  ng-submit='app.changePassword()')
  .modal-dialog.modal-sm
    .modal-content
      .modal-header.bg-primary
        button.close(type='button' data-dismiss='modal' aria-label='Close')
          span(aria-hidden='true') ×
        h4.modal-title {{app.isLang === "VN" ? "Đổi mật khẩu" : "Change password"}}
      .modal-body
        .form-bordered
          .form-group(validator)
            label {{app.isLang === "VN" ? "Mật khẩu hiện tại" : "Current password"}}
            input.form-control(name='currentPw' type='password' placeholder='{{app.isLang === "VN" ? "Nhập mật khẩu hiện tại" : "Your current password"}}'
              ng-model='app.objPass.oldPassword' required autocomplete='off')
          .form-group(validator)
            label {{app.isLang === "VN" ? "Mật khẩu mới" : "New password"}}
            input.form-control(name='newPw' type='password' placeholder='{{app.isLang === "VN" ? "Nhập mật khẩu mới" : "Your new password"}}'
              ng-model='app.objPass.newPassword' required autocomplete='off')
          .form-group(validator)
            label {{app.isLang === "VN" ? "Xác nhận mật khẩu" : "Password confirmation"}}
            input.form-control(name='newPwConfirm' type='password' placeholder='{{app.isLang === "VN" ? "Nhập xác nhận mật khẩu" : "Confirm your new password"}}'
              ng-model="app.objPass.passwordConfirm" required autocomplete='off' data-matched='newPw')
      .modal-footer
        button.btn.btn-link(type='button' data-dismiss='modal') {{app.isLang === "VN" ? "Hủy bỏ" : "Cancel"}}
        input.btn.btn-primary(type='submit' ng-disabled='fmPass.$invalid' ng-value='app.isLang === "VN" ? "Cập nhật" : "Update password"')
