form#fmLocation.modal.fade
  .modal-dialog
    .modal-content
      .modal-header.bg-success
        button.close(type='button', data-dismiss='modal', aria-label='Close') ×
        h4.modal-title {{app.isLang === "VN" ? "Địa điểm" : "Locations"}}
      .table-responsive.overflow-auto.mb-20(style='max-height: 400px')
        table.table
          thead
            tr
              th {{app.isLang === "VN" ? "STT" : "No"}}
              th {{app.isLang === "VN" ? "Tên" : "Name"}}
              th Wifi Network
          tbody
            tr(ng-if='!vm.obj.locations.length')
              td(colspan='5')
                h4.text-center.text-muted {{app.isLang === "VN" ? "Không tồn tại AP nào trên địa điểm này" : "Not available AP on this location"}}
            tr(ng-repeat='l in vm.obj.locations track by $index' data-dragula-id='{{l.campaignId}}')
              td(ng-bind='$index + 1')
              td(ng-bind='l.locationName')
              td(ng-bind='l.categoryName')
