form#fmCampaign.modal.fade(novalidate name='fm.fmCam')
  .modal-dialog
    .modal-content
      .modal-header.bg-success
        button.close(type='button', data-dismiss='modal', aria-label='Close') ×
        h4.modal-title {{app.isLang === "VN" ? "Chiến dịch ưu tiên" : "Campaign Priority"}}
      .table-responsive.overflow-auto.mb-20(style='max-height: 400px')
        table.table
          thead
            tr
              th
              th {{app.isLang === "VN" ? "STT" : "No"}}
              th {{app.isLang === "VN" ? "Chiến dịch" : "Campaign"}}
              th.text-right {{app.isLang === "VN" ? "Tổng KPI" : "Total KPI"}}
              th.text-right {{app.isLang === "VN" ? "KPI hàng ngày" : "Daily KPI"}}
              th
          tbody(dragula='vm.fmCampaignDragulaOptions')
            tr(ng-if='!vm.obj.activeCampaigns.length')
              td(colspan='5')
                h4.text-center.text-muted {{app.isLang === "VN" ? "Không có chiến dịch nào đang chạy ở địa điểm này" : "No running campaign on this location"}}
            tr(ng-repeat='l in vm.obj.activeCampaigns' data-dragula-id='{{l.campaignId}}')
              td
                i.icon-grid
              td(ng-bind='$index + 1')
              td(ng-bind='l.campaignName')
              td.text-right(ng-bind='l.kpi ? (l.kpi | number:0) : "Unlimited"')
              td.text-right(ng-bind='l.kpiPerDay ? (l.kpiPerDay | number:0) : "Unlimited"')
              td(ng-if="vm.campaignMap[l.campaignId].isCatfish")
                button.btn.btn-success(type='button' data-toggle='modal' data-target='#fmCatfishCode' ng-click='vm.onAction("getCatfishCode", l)') Get Catfish Code
      .modal-body
        label.text-primary {{app.isLang === "VN" ? "Giữ chuột và kéo thả để thay đổi thứ tự ưu tiên của chiến dịch" : "Hold and drag the handles to change campaign's ordes"}}
      .modal-footer
        button.btn.btn-link(type='button' data-dismiss='modal') {{app.isLang === "VN" ? "Hủy bỏ" : "Cancel"}}
        button.btn.btn-success(data-dismiss='modal' ng-click='vm.onAction("applyCampaign")') {{app.isLang === "VN" ? "Áp dụng" : "Apply"}}
