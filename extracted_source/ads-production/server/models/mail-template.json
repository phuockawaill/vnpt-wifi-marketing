{
    "name": "MailTemplate",
    "base": "PersistedModel",
    "idInjection": true,
    "options": {
        "validateUpsert": true
    },
    "mixins": {
        "TimeStamp": {
            "validateUpsert": true,
            "required": false
        },
        "Creator": {}
    },
    "properties": {
        "type": {
            "type": "string"
        },
        "htmlTemplate": {
            "type": "string"
        },
        "used": {
            "type": "boolean",
            "default": false
        }
    },
    "validations": [],
    "relations": {
        "mailQueues": {
            "type": "hasMany",
            "model": "MailQueue",
            "foreignKey": "mailTemplateId"
        }
    },
    "acls": [
        {
            "accessType": "*",
            "principalType": "ROLE",
            "principalId": "$unauthenticated",
            "permission": "DENY"
        },
        {
            "accessType": "*",
            "principalType": "ROLE",
            "principalId": "$authenticated",
            "permission": "ALLOW"
        },
        {
            "accessType": "*",
            "principalType": "ROLE",
            "principalId": "admin",
            "permission": "ALLOW"
        }
    ],
    "methods": {}
}