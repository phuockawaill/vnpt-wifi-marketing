{
  "restApiRoot": "/api",
  "host": "127.0.0.1",
  "port": 8085,
  "cookieSecret": "secret",
  "remoting": {
    "context": false,
    "rest": {
      "handleErrors": false,
      "normalizeHttpPath": false,
      "xml": false
    },
    "json": {
      "strict": false,
      "limit": "100kb"
    },
    "urlencoded": {
      "extended": true,
      "limit": "100kb"
    },
    "cors": false
  },
  "cloudcmd": {
    "rootDir": "/",
    "mountPath": "/cloudcmd",
    "resourceUrl": "",
    "resourcePath": "/resource",
    "editor": "dword",
    "packer": "zip",
    "maxFileSize": 10
  }
}
