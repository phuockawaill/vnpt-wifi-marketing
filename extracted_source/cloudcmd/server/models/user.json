{
  "name": "user",
  "plural": "users",
  "base": "User",
  "strict": true,
    "mixins": {
    "ReadOnly": {
      "clientId": true,
      "secretkey": true,
      "clientkey": true,
      "passwordConfirm": true,
      "isAdmin": true
    }
  },
  "hidden": [
    "password"
  ],
  "properties": {
    "clientId": {
      "type": "string",
      "length": 64
    },
    "type": {
      "type": "number",
      "length": 10
    },
    "rootdir": {
      "type": "string",
      "length": 255
    },
    "secretkey": {
      "type": "string",
      "length": 64
    },
    "clientkey": {
      "type": "string",
      "length": 64
    },
    "realm": false,
    "emailVerified": false,
    "verificationToken": false
  },
  "validations": [],
  "relations": {
    "accessTokens": {
      "type": "hasMany",
      "model": "accessToken",
      "foreignKey": "userId"
    }
  },
  "acls": [
    {
      "accessType": "READ",
      "principalType": "ROLE",
      "principalId": "$unauthenticated",
      "permission": "DENY"
    },
    {
      "accessType": "EXECUTE",
      "principalType": "ROLE",
      "principalId": "$unauthenticated",
      "permission": "ALLOW",
      "property": "loginCustom"
    },
    {
      "accessType": "*",
      "principalType": "ROLE",
      "principalId": "$authenticated",
      "permission": "ALLOW"
    }
  ],
  "methods": {}
}
