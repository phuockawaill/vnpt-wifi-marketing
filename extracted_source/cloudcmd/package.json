{
  "name": "file-manager",
  "version": "1.0.0",
  "main": "server/server.js",
  "scripts": {
    "lint": "eslint server",
    "start": "node .",
    "dev-server": "nodemon --watch server -e js,json server/server.js",
    "pre-build": "rimraf dist && npm run lint && nsp check",
    "build": "babel -d dist 'server/**/*.js' && copyfiles 'server/**/*.json' dist && copyfiles 'views/**/*.*' dist"
  },
  "dependencies": {
    "babel-register": "^6.26.0",
    "babel-polyfill": "^6.26.0",
    "bluebird": "^3.5.0",
    "body-parser": "^1.17.1",
    "cloudcmd": "^6.9.3",
    "compression": "^1.0.3",
    "content-type": "^1.0.2",
    "cookie-parser": "^1.4.3",
    "cors": "^2.5.2",
    "debug": "^2.6.3",
    "dotenv": "^4.0.0",
    "file-type": "^4.3.0",
    "fs-extra": "^3.0.1",
    "helmet": "^1.3.0",
    "json-web-token": "^2.1.3",
    "lodash": "^4.17.4",
    "loopback": "^3.11.1",
    "loopback-boot": "^2.26.1",
    "loopback-component-explorer": "^4.0.0",
    "loopback-connector-kv-redis": "^1.1.0",
    "loopback-connector-mongodb": "^3.2.1",
    "loopback-connector-redis": "^0.1.0",
    "loopback-datasource-juggler": "^3.5.0",
    "pug": "^2.0.0-beta9",
    "restafary": "^2.1.4",
    "serve-favicon": "^2.0.1",
    "socket.io": "^1.7.3",
    "strong-error-handler": "^2.0.0",
    "x-frame-options": "^1.0.0"
