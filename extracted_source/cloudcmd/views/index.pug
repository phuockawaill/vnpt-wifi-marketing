doctype html
html
  - var mountPath = locals.mountPath;
  - var type = locals.type;
  head
    meta(charset='utf-8')
    meta(name='robots', content='noindex,nofollow')
    meta(name='theme-color', content='rgb(49,123,249)')
    // mobile first design
    meta(content='width=device-width,initial-scale=1', name='viewport')
    link(href="data:image/x-icon;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQEAYAAABPYyMiAAAABmJLR0T///////8JWPfcAAAACXBIWXMAAABIAAAASABGyWs+AAAAF0lEQVRIx2NgGAWjYBSMglEwCkbBSAcACBAAAeaR9cIAAAAASUVORK5CYII=" rel="icon" type="image/x-icon")
    title File manager
    //if IE
      script(src='http://html5shiv.googlecode.com/svn/trunk/html5.js')
    link(rel='stylesheet', href=mountPath + '/css/urls.css')
    link(rel='stylesheet', href=mountPath + '/join:css/reset.css:css/style.css:css/icons.css:css/help.css:css/query.css:css/supports.css')
    link(rel='stylesheet', media='all', href='/style/app.css')
    link(rel='stylesheet', media='all', href='https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css')
    noscript
      link(rel='stylesheet', href=mountPath + '/css/nojs.css')
  body
    .fm
      section.panel.panel-left.panel-single(data-name='js-left')
        .reduce-text.clearfix(data-name='js-path', title='/')
          span.path-icon.icon-clear(data-name='js-clear-storage', title='clear storage (Ctrl+D)')
          a.path-icon.icon-refresh(data-name='js-refresh', href=mountPath + '/fs/', title='refresh (Ctrl+R)')
          span.links(data-name='js-links')
            a(data-name='js-path-link', href=mountPath + '/fs/', title='Root') /
        .fm-header(data-name='js-fm-header')
        ul.files(data-name='js-files')
      section.panel.panel-right(data-name='js-right')
        .reduce-text.clearfix(data-name='js-path', title='/')
          span.path-icon.icon-clear(data-name='js-clear-storage', title='clear storage (Ctrl+D)')
          a.path-icon.icon-refresh(data-name='js-refresh', href=mountPath + '/fs/', title='refresh (Ctrl+R)')
          span.links(data-name='js-links')
            a(data-name='js-path-link', href=mountPath + '/fs/', title='Root') /
        .fm-header(data-name='js-fm-header')
        ul.files(data-name='js-files')
      section.nav
        nav#js-keyspanel.keyspanel
          ul.cf
            li.menu-new
              a.dropdown(href='#')
                button.btn-outline.trans
                  i.fa.fa-fw.fa-plus
                  span New
              ul
                li
                  a(data-name='js-new-file', title='New File')
                    span.icon.text-file
                    span.reduce-text File
                li
                  a(data-name='js-new-directory', title='New Directory')
                    span.icon.directory
                    span.reduce-text Directory
                li
                  a(data-name='js-upload', title='Upload')
                    span.icon.icon-upload
                    span.reduce-text Upload
                li
                  a(data-name='js-upload-cloud', title='Upload from cloud')
                    span.icon.icon-upload-from-cloud
                    span.reduce-text Cloud Upload
            li
              a
                button#f3.cmd-button.reduce-text.icon-view(title='View')
            li
              a
                button#f8.cmd-button.reduce-text.icon-delete(title='Delete')
            li(style=type === 0 ? "display:none" : "display:block")
              a
                form(method='POST', action='/config')
                  button.cmd-button.reduce-text.icon-config(title='Config')
            li.menu-logout
              a
                form(method='POST', action='/api/users/logout')
                  button.cmd-button.reduce-text(title='Logout')
                    i.fa.fa-sign-out
    script(src=mountPath + '/cloudcmd.js')
    script.
      CloudCmd(JSON.parse('!{ config }'));
    //- monkey patch
    script(src='/js/app.js')
    script.
      CloudCmd.loadDir({ path: '#{ path }' });
