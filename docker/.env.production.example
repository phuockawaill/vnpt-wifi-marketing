# Tên miền chính thức của hệ thống (Do VNPT Đắk Lắk cấp)
PORTAL_DOMAIN=portal.daklak.vnpt.vn
ADMIN_DOMAIN=admin.daklak.vnpt.vn
API_PUBLIC_URL=https://portal.daklak.vnpt.vn/api

# Cơ sở dữ liệu PostgreSQL
POSTGRES_USER=vnpt_admin
POSTGRES_PASSWORD=VnptDakLak2026@SecurePass
POSTGRES_DB=vnpt_wifi_marketing

# Bảo mật JWT
JWT_SECRET=vnpt-daklak-production-secret-token-key-2026
JWT_EXPIRES_IN=7d

# Thiết bị mạng: false = gửi lệnh đến Modem GPON / MikroTik / UniFi thật
MOCK_GATEWAY_ENABLED=false

# Email đăng ký nhận chứng chỉ bảo mật SSL Let's Encrypt
CERTBOT_EMAIL=cntt.daklak@vnpt.vn
